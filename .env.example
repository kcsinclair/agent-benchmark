# Copy to .env and edit:  cp .env.example .env && chmod 600 .env
#
# THIS REPO IS PUBLIC. .env is gitignored and .env.example is not — never put a
# real key in this file, and never paste one into a transcript, an issue or a
# commit message. A key committed here is a key published.
#
# Read by both bench.sh and benchmark/run_http.py, with the same rules: KEY=value
# lines, # comments and blanks skipped, surrounding quotes stripped. It is parsed,
# never sourced, so there is no interpolation and no shell expansion. A variable
# already exported in your environment wins over the value here.

# ---------------------------------------------------------------- profiles --
#
# A profile is a named endpoint. `./bench.sh oneshot3 anthropic <model>` then
# means "the coding track, three passes, against the endpoint and provider pin
# named anthropic". Only _URL is required.
#
#   _URL        base server URL, passed to the runners as -s
#   _KEY        API key. Bridged to $OPENROUTER_API_KEY for the runner, used as
#               a Bearer header, and never written to a transcript or summary.
#   _KEY_FILE   path to a file holding the key, if you would rather not put it
#               here. Use one or the other, not both.
#   _PROVIDER   OpenRouter upstream pin. NOT OPTIONAL for anything you intend to
#               publish — see "Pin the provider" in RUNNING.md.
#   _LABEL      which results/<label>/ directory the runs belong to. Defaults to
#               the first dot-segment of the hostname, which collides for any
#               two hosts called api.*.
#   _ARGS       extra runner flags applied to every run of this profile.
#
# Profile names are case-insensitive and may contain hyphens: BENCH_PROFILE_GPT_OSS_URL
# is the profile `gpt-oss`.

# Claude, pinned to Anthropic's own endpoint rather than one of the eight
# upstreams the slug can route to.
BENCH_PROFILE_ANTHROPIC_URL=https://openrouter.ai/api
BENCH_PROFILE_ANTHROPIC_PROVIDER=Anthropic
BENCH_PROFILE_ANTHROPIC_LABEL=openrouter
BENCH_PROFILE_ANTHROPIC_KEY=sk-or-v1-REPLACE-ME

# A second hosted profile. For open-weight models the pin is the whole
# experiment: one slug can route to bf16, fp8 and fp4 endpoints, and this
# benchmark scores Q4_K_M and Q8_0 as separate contestants. List what a slug
# actually offers before choosing:
#   curl -s https://openrouter.ai/api/v1/models/<slug>/endpoints | python3 -m json.tool
BENCH_PROFILE_DEEPINFRA_URL=https://openrouter.ai/api
BENCH_PROFILE_DEEPINFRA_PROVIDER=DeepInfra
BENCH_PROFILE_DEEPINFRA_LABEL=openrouter
BENCH_PROFILE_DEEPINFRA_KEY=sk-or-v1-REPLACE-ME

# The local llama.cpp server. No key: nothing is sent to a non-OpenRouter URL.
# Use localhost when the harness runs on the serving box itself.
BENCH_PROFILE_LEIA_URL=http://localhost:7442
BENCH_PROFILE_LEIA_LABEL=leia

# ------------------------------------------------------------- speed track --
#
# `./bench.sh speed <box> <model|all>` runs llama-bench over ssh, even when the
# target is this machine — one code path whether the harness is local or remote.
# It stops llama-server.service for the duration and restarts it on exit, which
# is why the box and the models are named on the command line rather than
# defaulted into.
#
# <box> names results/<box>/speed and, unless something below overrides it, the
# ssh target as well. Keeping the two separate is not cosmetic:
# run_llama_bench.sh names its output after the ssh host, so with localhost the
# numbers would land in results/localhost/ and collate_bench.py could no longer
# join them to the scores in results/leia/.
#
# These four configure the box named by BENCH_SPEED_LABEL — `./bench.sh speed
# leia all` then sshes to BENCH_SPEED_HOST and writes results/leia/speed.
BENCH_SPEED_HOST=localhost
BENCH_SPEED_LABEL=leia
BENCH_SPEED_MODELDIR=/opt/local-ai/models
BENCH_SPEED_BINDIR=/opt/local-ai/bin

# Any further box is named per box. With none of these set, the box name is
# used as the ssh target, which is the common case and needs no configuration.
# BENCH_SPEED_MAC_SSH=mac.local
# BENCH_SPEED_MAC_MODELDIR=/Users/me/models
# BENCH_SPEED_MAC_BINDIR=/opt/homebrew/bin

# ------------------------------------------------------------------ legacy --
#
# Still honoured: a bare key used by any OpenRouter profile that defines no _KEY
# of its own, and the default server for the runners when called directly.
# OPENROUTER_API_KEY=sk-or-v1-REPLACE-ME
# BENCH_SERVER=http://localhost:7442
